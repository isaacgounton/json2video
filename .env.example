# API Configuration
API_KEY=your_api_key_here

# Cloud Storage Configuration
# You can use either GCP or S3-compatible storage (including MinIO)

# Option 1: Google Cloud Platform Storage
# GCP_BUCKET_NAME=your-gcp-bucket-name
# GCP_SA_CREDENTIALS=/path/to/service-account-key.json

# Option 2: S3-Compatible Storage (AWS S3, MinIO, DigitalOcean Spaces, etc.)
# S3_ENDPOINT_URL=https://your-s3-endpoint.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=your-region

# MinIO Example:
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=videos
# S3_REGION=us-east-1

# DigitalOcean Spaces Example:
# S3_ENDPOINT_URL=https://your-space-name.nyc3.digitaloceanspaces.com
# S3_ACCESS_KEY=your-do-spaces-key
# S3_SECRET_KEY=your-do-spaces-secret
# Note: For DigitalOcean, bucket and region can be auto-extracted from URL

# Legacy compatibility (will use GCP if set)
# BUCKET_NAME=your-legacy-bucket-name
